# Database configuration
# Shloss connects to the DB service name defined in compose
SHLOSS_DATABASE_URL=postgresql://shloss_admin:your_super_secret_generated_db_password@db:5432/shloss
DB_PASSWORD=your_super_secret_generated_db_password

# RSA Keys
# In production, these should be multi-line strings injected by your CI/CD or host environment
SHLOSS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

SHLOSS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
